# Private and team rings never live in core
/local/
/team/

# Never commit secrets
*secrets.env
*.key
.env

# Local state
/.os-state/

# Editor config stays local
/.vscode/

# Scratch and generated artifacts that must never be committed (2026-07-26:
# an accidental `git add -A` swept meeting transcripts into a public repo).
.tmp/
__pycache__/
*.pyc
/et_*.html
/profile.html
